APP_NAME="Luxe Shop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-random-32-char-string
APP_TIMEZONE=Asia/Ho_Chi_Minh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luxe_shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=luxe_session
SESSION_LIFETIME=7200

MAIL_FROM=noreply@luxe-shop.local

# Shipping (VND)
SHIPPING_FEE=30000
FREE_SHIPPING_MIN=500000

# Reviews: only buyers can review when true
VERIFIED_PURCHASE_ONLY=true

# Rate limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Payment placeholders — never commit real keys
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
